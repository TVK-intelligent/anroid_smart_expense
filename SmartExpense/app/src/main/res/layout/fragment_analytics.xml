<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_slate">

    <!-- Title Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/surface_white"
        android:elevation="1dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SmartExpense Hub"
            android:textColor="@color/primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Custom Premium Segmented Pill Selector (High Fidelity spacing) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@color/surface_white"
        android:elevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_pill_chip"
            android:padding="3dp">

            <TextView
                android:id="@+id/tab_analytics"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Phân Tích"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="@drawable/bg_pill_chip_active"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tab_budgets"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Ngân Sách"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tab_savings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Mục Tiêu"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- ================= TAB 1: ANALYTICS ================= -->
            <LinearLayout
                android:id="@+id/layout_analytics_tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Financial Health Card & Spending Trend Side-by-Side (High Fidelity visual score) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface_white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Financial Health Score"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="16dp">

                            <!-- Circle score simulation -->
                            <RelativeLayout
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:background="@drawable/bg_circle_border">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    android:text="84"
                                    android:textColor="@color/primary"
                                    android:textSize="24sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Trạng thái: Xuất sắc"
                                    android:textColor="@color/emerald_income"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Thói quen tích lũy của bạn tốt hơn 95% người dùng trong tuần này."
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Spending Trends Line Chart Simulation -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface_white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Spending Trends (Xu hướng)"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:text="-12.4% so với tuần trước"
                                android:textColor="@color/emerald_income"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Real MPAndroidChart BarChart for premium statistics -->
                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/chart_spending_trends"
                            android:layout_width="match_parent"
                            android:layout_height="130dp"
                            android:layout_marginBottom="8dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- AI Smart Insight Banner (Premium styling) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/primary"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI SMART INSIGHT"
                            android:textColor="#CCFFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&quot;Tuần này bạn tiết kiệm được 15% ăn uống bằng cách đi chợ truyền thống. Nếu tiếp tục duy trì, bạn sẽ tích lũy dư ra 980,000đ để đạt mục tiêu mua Laptop sớm 1 tháng!&quot;"
                            android:textColor="@color/surface_white"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp"
                            android:lineSpacingMultiplier="1.2" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Rule-Based Burn Rate Dynamic Check Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface_white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đo Lường Tốc Độ Chi Tiêu (Burn Rate)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nhấn nút để chạy thuật toán kiểm tra tốc độ rút số dư ví offline của bạn."
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_check_burn_rate"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Chạy Thuật Toán Phân Tích"
                            android:textColor="@color/surface_white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/accent_blue"
                            app:cornerRadius="12dp" />

                        <!-- Burn Rate Result Container -->
                        <LinearLayout
                            android:id="@+id/layout_burn_rate_result"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:layout_marginTop="16dp"
                            android:padding="12dp"
                            android:background="@drawable/bg_pill_chip_active">

                            <TextView
                                android:id="@+id/tv_burn_rate_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TỐC ĐỘ BÌNH THƯỜNG"
                                android:textColor="@color/primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_burn_rate_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mô tả..."
                                android:textColor="@color/text_primary"
                                android:textSize="11sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ================= TAB 2: BUDGETS ================= -->
            <LinearLayout
                android:id="@+id/layout_budget_tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Monthly Status Summary Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface_white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TỔNG QUAN NGÂN SÁCH THÁNG NÀY"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:id="@+id/tv_budget_spend_total"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2,450,000đ"
                                android:textColor="@color/text_primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_budget_limit_total"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toRightOf="@id/tv_budget_spend_total"
                                android:layout_alignBaseline="@id/tv_budget_spend_total"
                                android:text=" / 3,200,000đ"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:text="Đúng Kế Hoạch"
                                android:textColor="@color/emerald_income"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:background="@drawable/bg_pill_chip_active" />
                        </RelativeLayout>

                        <!-- Global Progress -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đã chi tiêu 76% ngân sách • Còn lại 750,000đ"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="6dp" />

                        <ProgressBar
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:progress="76"
                            android:progressTint="@color/secondary"
                            android:progressBackgroundTint="@color/progress_track" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Category Budgets List (High Fidelity warning indicators) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ngân Sách Theo Hạng Mục"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Dining & Food (Near Limit - 97%) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface_white"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tv_cat1_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ăn Uống (Dining &amp; Food)"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/tv_cat1_title"
                                android:text="⚠️ Sắp chạm hạn mức"
                                android:textColor="@color/crimson_expense"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:text="780,000đ / 800,000đ"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </RelativeLayout>

                        <ProgressBar
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="8dp"
                            android:progress="97"
                            android:progressTint="@color/crimson_expense"
                            android:progressBackgroundTint="@color/progress_track" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Transport (Healthy - 46%) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface_white"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Di Chuyển (Transport)"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:text="210,000đ / 450,000đ"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </RelativeLayout>

                        <ProgressBar
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="8dp"
                            android:progress="46"
                            android:progressTint="@color/accent_blue"
                            android:progressBackgroundTint="@color/progress_track" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Entertainment (Over budget - 100%) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface_white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tv_cat3_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Giải Trí (Entertainment)"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/tv_cat3_title"
                                android:text="❌ Vượt ngân sách +40,000đ"
                                android:textColor="@color/crimson_expense"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:text="340,000đ / 300,000đ"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </RelativeLayout>

                        <ProgressBar
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="8dp"
                            android:progress="100"
                            android:progressTint="@color/crimson_expense"
                            android:progressBackgroundTint="@color/progress_track" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Add new budget category button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_budget"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="+ Thêm Mới Ngân Sách Hạng Mục"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/surface_white"
                    app:strokeColor="@color/text_secondary"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <!-- ================= TAB 3: SAVINGS GOALS ================= -->
            <LinearLayout
                android:id="@+id/layout_savings_tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Savings Hero Progress Summary -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface_white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TỔNG TIẾN TRÌNH TÍCH LŨY"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="42,850,000đ"
                            android:textColor="@color/primary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đã đạt 68% mục tiêu chung"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:text="Mục tiêu: 63,000,000đ"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <ProgressBar
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:progress="68"
                            android:progressTint="@color/accent_blue"
                            android:progressBackgroundTint="@color/progress_track" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Active Goals section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Danh Sách Mục Tiêu Cá Nhân"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Dynamic Suggestions / Offline Goal grid -->
                <LinearLayout
                    android:id="@+id/layout_savings_suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Default suggestion item for laptop -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="@color/surface_white"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:id="@+id/tv_goal_laptop_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tích Lũy Mua Laptop Workstation"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@id/tv_goal_laptop_title"
                                    android:text="Hạn chót: Tháng 12/2026"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="10sp"
                                    android:layout_marginTop="2dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:text="82%"
                                    android:textColor="@color/accent_blue"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đã tích lũy: 24,600,000đ / 30,000,000đ"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:layout_marginBottom="8dp" />

                            <ProgressBar
                                style="@android:style/Widget.ProgressBar.Horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:progress="82"
                                android:progressTint="@color/accent_blue"
                                android:progressBackgroundTint="@color/progress_track"
                                android:layout_marginBottom="12dp"/>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:text="💡 Gợi ý trích: +1,500,000đ/tháng"
                                    android:textColor="@color/primary"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:layout_alignParentRight="true"
                                    android:text="Nạp Quỹ"
                                    android:textColor="@color/surface_white"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:padding="0dp"
                                    android:backgroundTint="@color/primary"
                                    app:cornerRadius="8dp" />
                            </RelativeLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Default suggestion item for Travel -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="@color/surface_white"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:id="@+id/tv_goal_travel_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Đi Du Lịch Phú Quốc"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@id/tv_goal_travel_title"
                                    android:text="Hạn chót: Tháng 08/2026"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="10sp"
                                    android:layout_marginTop="2dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:text="45%"
                                    android:textColor="@color/accent_blue"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đã tích lũy: 3,600,000đ / 8,000,000đ"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:layout_marginBottom="8dp" />

                            <ProgressBar
                                style="@android:style/Widget.ProgressBar.Horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:progress="45"
                                android:progressTint="@color/accent_blue"
                                android:progressBackgroundTint="@color/progress_track"
                                android:layout_marginBottom="12dp"/>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:text="💡 Gợi ý trích: +800,000đ/tháng"
                                    android:textColor="@color/primary"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:layout_alignParentRight="true"
                                    android:text="Nạp Quỹ"
                                    android:textColor="@color/surface_white"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:padding="0dp"
                                    android:backgroundTint="@color/primary"
                                    app:cornerRadius="8dp" />
                            </RelativeLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Create new goal category button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_create_goal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="+ Thiết Lập Mục Tiêu Tích Lũy Mới"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/surface_white"
                    app:strokeColor="@color/text_secondary"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </FrameLayout>
    </ScrollView>
</LinearLayout>
