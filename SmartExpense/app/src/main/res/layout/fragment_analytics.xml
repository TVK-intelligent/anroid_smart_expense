<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_slate">

    <!-- Title Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/surface_white"
        android:elevation="1dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SmartExpense Hub"
            android:textColor="@color/primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Custom Premium Segmented Pill Selector (High Fidelity spacing) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@color/surface_white"
        android:elevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_pill_chip"
            android:padding="3dp">

            <TextView
                android:id="@+id/tab_analytics"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/analytics_tab_analysis"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="@drawable/bg_pill_chip_active"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tab_budgets"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/analytics_tab_budget"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tab_savings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/analytics_tab_goals"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- ================= TAB 1: ANALYTICS ================= -->
            <LinearLayout
                android:id="@+id/layout_analytics_tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Financial Health Card & Spending Trend Side-by-Side (High Fidelity visual score) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface_white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Financial Health Score"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="16dp">

                            <!-- Circle score simulation -->
                            <RelativeLayout
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:background="@drawable/bg_circle_border">

                                <TextView
                                    android:id="@+id/tv_health_score"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    android:text="84"
                                    android:textColor="@color/primary"
                                    android:textSize="24sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="16dp">

                                <TextView
                                    android:id="@+id/tv_health_status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/health_status_excellent"
                                    android:textColor="@color/emerald_income"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_health_desc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/health_desc_excellent"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Spending Trends Line Chart Simulation -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface_white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/analytics_spending_trends"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_weekly_comparison"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:text="@string/analytics_calculating"
                                android:textColor="@color/emerald_income"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Real MPAndroidChart BarChart for premium statistics -->
                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/chart_spending_trends"
                            android:layout_width="match_parent"
                            android:layout_height="130dp"
                            android:layout_marginBottom="8dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- AI Smart Insight Banner (Premium styling) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/primary"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/analytics_ai_insight_header"
                            android:textColor="#CCFFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tv_ai_smart_insight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/analytics_ai_insight_loading"
                            android:textColor="@color/surface_white"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp"
                            android:lineSpacingMultiplier="1.2" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Rule-Based Burn Rate Dynamic Check Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface_white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/analytics_burn_rate_title"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/analytics_burn_rate_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_check_burn_rate"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="@string/analytics_burn_rate_btn"
                            android:textColor="@color/surface_white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/accent_blue"
                            app:cornerRadius="12dp" />

                        <!-- Burn Rate Result Container -->
                        <LinearLayout
                            android:id="@+id/layout_burn_rate_result"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:layout_marginTop="16dp"
                            android:padding="12dp"
                            android:background="@drawable/bg_pill_chip_active">

                            <TextView
                                android:id="@+id/tv_burn_rate_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TỐC ĐỘ BÌNH THƯỜNG"
                                android:textColor="@color/primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_burn_rate_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mô tả..."
                                android:textColor="@color/text_primary"
                                android:textSize="11sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ================= TAB 2: BUDGETS ================= -->
            <LinearLayout
                android:id="@+id/layout_budget_tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Monthly Status Summary Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface_white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/analytics_budget_overview"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:id="@+id/tv_budget_spend_total"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2,450,000đ"
                                android:textColor="@color/text_primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_budget_limit_total"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toRightOf="@id/tv_budget_spend_total"
                                android:layout_alignBaseline="@id/tv_budget_spend_total"
                                android:text=" / 3,200,000đ"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_budget_status_pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:text="@string/analytics_budget_status_on_track"
                                android:textColor="@color/emerald_income"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:background="@drawable/bg_pill_chip_active" />
                        </RelativeLayout>

                        <!-- Global Progress -->
                        <TextView
                            android:id="@+id/tv_budget_global_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đã chi tiêu 76% ngân sách • Còn lại 750,000đ"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="6dp" />

                        <ProgressBar
                            android:id="@+id/pb_budget_global"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:progress="76"
                            android:progressTint="@color/secondary"
                            android:progressBackgroundTint="@color/progress_track" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Category Budgets List (High Fidelity warning indicators) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analytics_category_budgets_title"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />


                <!-- Dynamic Category Budgets Container -->
                <LinearLayout
                    android:id="@+id/layout_budgets_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp" />

                <!-- Add new budget category button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_budget"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/analytics_add_budget_btn"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/surface_white"
                    app:strokeColor="@color/text_secondary"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <!-- ================= TAB 3: SAVINGS GOALS ================= -->
            <LinearLayout
                android:id="@+id/layout_savings_tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Savings Hero Progress Summary -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface_white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/analytics_savings_progress_title"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tv_savings_total_current"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0đ"
                            android:textColor="@color/primary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:id="@+id/tv_savings_total_percent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đã đạt 0% mục tiêu chung"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_savings_total_target"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:text="Mục tiêu: 0đ"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <ProgressBar
                            android:id="@+id/pb_savings_total"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:progress="0"
                            android:progressTint="@color/accent_blue"
                            android:progressBackgroundTint="@color/progress_track" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- AI Smart Suggestion Overview Container -->
                <LinearLayout
                    android:id="@+id/layout_ai_surplus_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_pill_chip_active"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analytics_ai_suggestions_title"
                        android:textColor="@color/accent_blue"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tv_ai_surplus_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analytics_ai_suggestions_idle_cash"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ai_auto_allocate"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/analytics_ai_suggestions_auto_allocate"
                        android:textColor="@color/surface_white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary"
                        android:layout_marginTop="8dp"
                        app:cornerRadius="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Active Goals section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analytics_personal_goals_title"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Dynamic Suggestions / Offline Goal grid -->
                <LinearLayout
                    android:id="@+id/layout_savings_suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp" />

                <!-- Create new goal category button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_create_goal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/analytics_add_goal_btn"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/surface_white"
                    app:strokeColor="@color/text_secondary"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </FrameLayout>
    </ScrollView>
</LinearLayout>
