<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="96dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardPreventCornerOverlap="false"
    android:layout_marginEnd="12dp"
    android:layout_marginVertical="6dp">

    <!-- Background holds the dynamic gradient, set in Java -->
    <RelativeLayout
        android:id="@+id/layout_wallet_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/grad_wallet_default"
        android:padding="12dp">

        <!-- Top Left: Type -->
        <TextView
            android:id="@+id/tv_wallet_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:text="CREDIT CARD"
            android:textColor="#D8FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <!-- Top Right: Chip -->
        <ImageView
            android:id="@+id/iv_wallet_chip"
            android:layout_width="20dp"
            android:layout_height="14dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_card_chip"
            android:contentDescription="Chip" />

        <!-- Middle: Name -->
        <TextView
            android:id="@+id/tv_wallet_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Techcombank"
            android:textColor="@color/surface_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Bottom: Balance -->
        <TextView
            android:id="@+id/tv_wallet_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="0đ"
            android:textColor="@color/surface_white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
