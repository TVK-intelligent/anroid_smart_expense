<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Live Credit Card Preview -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_preview"
            android:layout_width="240dp"
            android:layout_height="135dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardPreventCornerOverlap="false"
            android:layout_marginBottom="24dp">

            <!-- Background Gradient (handled programmatically, default to default gradient) -->
            <RelativeLayout
                android:id="@+id/layout_preview_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/grad_wallet_default"
                android:padding="16dp">

                <!-- Top Row: Card Type and Chip -->
                <TextView
                    android:id="@+id/tv_preview_wallet_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:text="BANK ACCOUNT"
                    android:textColor="#D8FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <ImageView
                    android:id="@+id/iv_preview_chip"
                    android:layout_width="32dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:src="@drawable/ic_card_chip"
                    android:contentDescription="Card Chip" />

                <!-- Middle Row: Card / Wallet Name -->
                <TextView
                    android:id="@+id/tv_preview_wallet_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Tên Ví Tài Khoản"
                    android:textColor="@color/surface_white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Bottom Row: Balance Display -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SỐ DƯ"
                        android:textColor="#A0FFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tv_preview_wallet_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0đ"
                        android:textColor="@color/surface_white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Input Fields Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THÔNG TIN TÀI KHOẢN"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_gravity="start"
            android:layout_marginBottom="12dp" />

        <!-- Wallet Name TextInputLayout -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên Ví / Tài khoản (ví dụ: Techcombank, MoMo)"
            app:boxStrokeColor="@color/accent_blue"
            app:hintTextColor="@color/accent_blue"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_wallet_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Wallet Type Dropdown TextInputLayout -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Loại tài khoản / Ví"
            app:boxStrokeColor="@color/accent_blue"
            app:hintTextColor="@color/accent_blue"
            android:layout_marginBottom="16dp">

            <AutoCompleteTextView
                android:id="@+id/act_wallet_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Initial Balance TextInputLayout -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Số dư ban đầu (VND)"
            app:boxStrokeColor="@color/accent_blue"
            app:hintTextColor="@color/accent_blue"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_wallet_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
