<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartExpense"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Splash Activity: The entry point of the app -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartExpense">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Activity -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartExpense" />

        <!-- Register Activity -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartExpense" />

        <!-- Main Dashboard Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartExpense" />

        <!-- Recurring Transactions Activity -->
        <activity
            android:name=".activities.RecurringTransactionsActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartExpense" />

        <!-- Savings Goals Activity -->
        <activity
            android:name=".activities.SavingsGoalsActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartExpense" />

        <!-- Smart Chatbot Activity -->
        <activity
            android:name=".activities.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartExpense"
            android:windowSoftInputMode="adjustResize" />

        <!-- Debt & Loan Activity -->
        <activity
            android:name=".activities.DebtLoanActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartExpense" />

    </application>

</manifest>